FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    openssh-server \
    openssh-client \
    python3 \
    python3-pip \
    sudo \
    vim \
    curl \
    iproute2 \
    iputils-ping \
    net-tools \
    sshpass \
    mysql-client \
    && rm -rf /var/lib/apt/lists/*

# Install Ansible (pinned for reproducible builds across machines/architectures).
# Override at build time with: docker build --build-arg ANSIBLE_VERSION=X.Y.Z
ARG ANSIBLE_VERSION=10.7.0
RUN pip3 install --no-cache-dir "ansible==${ANSIBLE_VERSION}"

# Configure SSH
RUN mkdir /var/run/sshd \
    && echo 'root:ansible' | chpasswd \
    && sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/UsePAM yes/UsePAM no/g' /etc/ssh/sshd_config \
    && sed -i 's@session\s*required\s*pam_loginuid.so@session optional pam_loginuid.so@g' /etc/pam.d/sshd

# Point Ansible at the config in the mounted volume
ENV ANSIBLE_CONFIG=/root/ansible/ansible.cfg

# Disable host key checking for lab convenience.
# Use printf (not echo) so the escapes are written literally as newlines
# regardless of which /bin/sh implementation runs the RUN step.
RUN mkdir -p /root/.ssh \
    && printf 'Host *\n  StrictHostKeyChecking no\n  UserKnownHostsFile /dev/null\n' > /root/.ssh/config \
    && chmod 600 /root/.ssh/config

EXPOSE 22

# Generate SSH host keys at container startup (not build time) so each
# container gets unique keys instead of sharing keys baked into the image.
COPY start-ssh.sh /start-ssh.sh
RUN chmod +x /start-ssh.sh
CMD ["/start-ssh.sh"]
